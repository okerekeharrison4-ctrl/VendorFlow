{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile and settings",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "brandName": { "type": "string" },
        "currency": { "type": "string" },
        "vendorTaxId": { "type": "string" },
        "isPremium": { "type": "boolean" },
        "createdAt": { "type": "integer" },
        "updatedAt": { "type": "integer" }
      },
      "required": ["uid", "email", "createdAt"]
    },
    "Client": {
      "title": "Client",
      "description": "Customer/Client entity",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "address": { "type": "string" },
        "taxId": { "type": "string" },
        "createdAt": { "type": "integer" }
      },
      "required": ["userId", "name", "createdAt"]
    },
    "CatalogItem": {
      "title": "CatalogItem",
      "description": "Item in the catalog",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "name": { "type": "string" },
        "price": { "type": "number" },
        "description": { "type": "string" },
        "createdAt": { "type": "integer" }
      },
      "required": ["userId", "name", "price", "createdAt"]
    },
    "Invoice": {
      "title": "Invoice",
      "description": "Invoice record",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "invoiceNumber": { "type": "string" },
        "customerName": { "type": "string" },
        "clientId": { "type": "string" },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "name": { "type": "string" },
              "quantity": { "type": "number" },
              "price": { "type": "number" }
            }
          }
        },
        "status": { "type": "string", "enum": ["unpaid", "paid"] },
        "createdAt": { "type": "integer" },
        "updatedAt": { "type": "integer" },
        "paidAt": { "type": "integer" }
      },
      "required": ["userId", "invoiceNumber", "customerName", "items", "status", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "User profiles"
    },
    "/users/{userId}/clients/{clientId}": {
      "schema": { "$ref": "#/entities/Client" },
      "description": "Clients belonging to a user"
    },
    "/users/{userId}/catalog/{itemId}": {
      "schema": { "$ref": "#/entities/CatalogItem" },
      "description": "Catalog items belonging to a user"
    },
    "/users/{userId}/invoices/{invoiceId}": {
      "schema": { "$ref": "#/entities/Invoice" },
      "description": "Invoices belonging to a user"
    }
  }
}
