rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    
    // Because some providers (e.g. anonymous or basic Google login) might not enforce email_verified for all flows,
    // in our app context we might just require request.auth != null if we don't have explicit email verification required.
    // For now, let's use standard auth checked
    function isAuthOrDev() {
      // If we use standard email/pass, we might want to check email_verified.
      // Here we just check auth != null
      return request.auth != null;
    }

    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isOwner(userId) { return isAuthOrDev() && request.auth.uid == userId; }
    
    function isValidId(id) { 
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); 
    }
    
    function isStringSafe(val, maxLen) {
      return val is string && val.size() <= maxLen;
    }

    // --- Entity Validators --- //

    function isValidUser(data, userId) {
      return data.keys().hasAll(['uid', 'email', 'createdAt'])
        && data.uid == userId
        && isStringSafe(data.email, 256)
        && (data.createdAt is timestamp || data.createdAt is int)
        && (!('brandName' in data) || isStringSafe(data.brandName, 256))
        && (!('currency' in data) || isStringSafe(data.currency, 10))
        && (!('vendorTaxId' in data) || isStringSafe(data.vendorTaxId, 128))
        && (!('isPremium' in data) || data.isPremium is bool)
        && (!('updatedAt' in data) || data.updatedAt is timestamp || data.updatedAt is int);
    }

    function isValidClient(data) {
      return data.keys().hasAll(['name', 'createdAt'])
        && isStringSafe(data.name, 256)
        && (data.createdAt is timestamp || data.createdAt is int)
        && (!('userId' in data) || (data.userId == request.auth.uid))
        && (!('email' in data) || isStringSafe(data.email, 256))
        && (!('phone' in data) || isStringSafe(data.phone, 32))
        && (!('address' in data) || isStringSafe(data.address, 512))
        && (!('taxId' in data) || isStringSafe(data.taxId, 128));
    }

    function isValidCatalogItem(data) {
      return data.keys().hasAll(['name', 'price', 'createdAt'])
        && isStringSafe(data.name, 256)
        && (data.price is number)
        && (data.createdAt is timestamp || data.createdAt is int)
        && (!('userId' in data) || (data.userId == request.auth.uid))
        && (!('description' in data) || isStringSafe(data.description, 1024));
    }

    function isValidInvoiceItem(item) {
      return item is map
        && item.keys().hasAll(['id', 'name', 'quantity', 'price'])
        && isStringSafe(item.id, 128)
        && isStringSafe(item.name, 256)
        && item.quantity is number
        && item.price is number;
    }

    function isValidInvoice(data) {
      return data.keys().hasAll(['invoiceNumber', 'items', 'status', 'createdAt', 'updatedAt'])
        && isStringSafe(data.invoiceNumber, 128)
        && data.items is list
        && data.items.size() <= 100
        && (data.items.size() == 0 || isValidInvoiceItem(data.items[0]))
        && (data.status in ['unpaid', 'paid'])
        && (data.createdAt is timestamp || data.createdAt is int)
        && (data.updatedAt is timestamp || data.updatedAt is int)
        && (!('customerName' in data) || isStringSafe(data.customerName, 256))
        && (!('userId' in data) || (data.userId == request.auth.uid))
        && (!('clientId' in data) || isStringSafe(data.clientId, 128))
        && (!('paidAt' in data) || data.paidAt is timestamp || data.paidAt is int)
        && (!('notes' in data) || isStringSafe(data.notes, 2048))
        && (!('brandName' in data) || isStringSafe(data.brandName, 256))
        && (!('subtotal' in data) || data.subtotal is number)
        && (!('taxAmount' in data) || data.taxAmount is number)
        && (!('taxRate' in data) || data.taxRate is number)
        && (!('taxLabel' in data) || isStringSafe(data.taxLabel, 64))
        && (!('taxInclusive' in data) || data.taxInclusive is bool)
        && (!('vendorTaxId' in data) || isStringSafe(data.vendorTaxId, 128))
        && (!('clientTaxId' in data) || isStringSafe(data.clientTaxId, 128))
        && (!('template' in data) || data.template is map)
        && (!('bankDetails' in data) || data.bankDetails is map);
    }


    // --- Path Rules --- //

    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if false; // Users shouldn't list all users
      
      allow create: if isOwner(userId) && isValidId(userId) && isValidUser(incoming(), userId) && incoming().keys().size() <= 10;
      allow update: if isOwner(userId) && isValidId(userId) && isValidUser(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt;
      allow delete: if isOwner(userId) && isValidId(userId);

      match /clients/{clientId} {
        allow get: if isOwner(userId) && isValidId(clientId);
        allow list: if isOwner(userId);
        
        allow create: if isOwner(userId) && isValidId(clientId) && isValidClient(incoming()) && incoming().keys().size() <= 10;
        allow update: if isOwner(userId) && isValidId(clientId) && isValidClient(incoming())
          && incoming().createdAt == existing().createdAt
          && (!('userId' in existing()) || incoming().userId == existing().userId);
        allow delete: if isOwner(userId) && isValidId(clientId);
      }

      match /catalog/{itemId} {
        allow get: if isOwner(userId) && isValidId(itemId);
        allow list: if isOwner(userId);
        
        allow create: if isOwner(userId) && isValidId(itemId) && isValidCatalogItem(incoming()) && incoming().keys().size() <= 8;
        allow update: if isOwner(userId) && isValidId(itemId) && isValidCatalogItem(incoming())
          && incoming().createdAt == existing().createdAt
          && (!('userId' in existing()) || incoming().userId == existing().userId);
        allow delete: if isOwner(userId) && isValidId(itemId);
      }

      match /invoices/{invoiceId} {
        allow get: if isOwner(userId) && isValidId(invoiceId);
        allow list: if isOwner(userId);
        
        allow create: if isOwner(userId) && isValidId(invoiceId) && isValidInvoice(incoming()) && incoming().keys().size() <= 30;
        allow update: if isOwner(userId) && isValidId(invoiceId) && isValidInvoice(incoming())
          && incoming().createdAt == existing().createdAt
          && (!('userId' in existing()) || incoming().userId == existing().userId);
        allow delete: if isOwner(userId) && isValidId(invoiceId);
      }
    }
  }
}
